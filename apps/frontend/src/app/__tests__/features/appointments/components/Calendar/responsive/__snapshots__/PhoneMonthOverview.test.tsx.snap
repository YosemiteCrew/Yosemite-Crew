      </span>
      <span
        class="inline-flex flex-none items-center gap-[3px] rounded-full border px-2 py-[2.5px] text-[8.5px] font-bold bg-[var(--status-upcoming-bg)] text-[var(--status-upcoming-text)] border-[var(--status-upcoming-border)]"
      >
        UPCOMING
      </span>
    </div>
    <div
      class="flex items-center gap-2.5 rounded-[13px] bg-[var(--screen)] px-3 py-[9px] border border-[var(--hairline)] shadow-[0_1px_2px_var(--sh03)]"
    >
      <span
        class="w-[34px] flex-none text-[10.5px] font-bold tabular-nums text-[var(--ink-faint)]"
      >
        10:02
      </span>
      <span
        class="min-w-0 flex-1"
      >
        <span
          class="block truncate text-xs font-bold text-[var(--ink)]"
        >
          Poppy
        </span>
        <span
          class="block truncate text-[10px] text-[var(--ink-faint)]"
        />
      </span>
      <span
        class="inline-flex flex-none items-center gap-[3px] rounded-full border px-2 py-[2.5px] text-[8.5px] font-bold bg-[var(--status-upcoming-bg)] text-[var(--status-upcoming-text)] border-[var(--status-upcoming-border)]"
      >
        UPCOMING
      </span>
    </div>
    <span
      class="text-center text-[11px] font-semibold text-[var(--ink-faint)]"
    >
      +1 more · swipe up
    </span>
  </div>
</section>
`;
