// Copy this file to apps/mobileAppYC/ios/mobileAppYC/Secrets.xcconfig.
// Secrets.xcconfig is gitignored; never commit real values.
//
// Get this key from Google Cloud Console -> APIs & Services -> Credentials.
// Enable Maps SDK for iOS for this key.

GOOGLE_MAPS_API_KEY = YOUR_IOS_GOOGLE_MAPS_API_KEY

// Facebook app credentials, from developers.facebook.com -> your app -> Settings -> Basic.
// The client token is App Settings -> Advanced -> Client token. Both are read by
// Info.plist at build time; a build without them ships the literal placeholder and
// Facebook sign-in fails at runtime.

FACEBOOK_APP_ID = YOUR_FACEBOOK_APP_ID
FACEBOOK_CLIENT_TOKEN = YOUR_FACEBOOK_CLIENT_TOKEN

// Google Sign-In reversed client id, from GoogleService-Info.plist -> REVERSED_CLIENT_ID.
// Info.plist registers it as a URL scheme so Google can return to the app. It must match
// the GoogleService-Info.plist in this checkout, which is untracked and per-machine, so
// hard-coding it here would silently break sign-in for anyone using a different Firebase
// project: the build succeeds and the OAuth redirect has nowhere to land.

// Paste REVERSED_CLIENT_ID from GoogleService-Info.plist exactly as it appears.
// That value already begins with com.googleusercontent.apps., so do not add it again.
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.YOUR_FIREBASE_PROJECT_NUMBER-YOUR_IOS_CLIENT_ID
