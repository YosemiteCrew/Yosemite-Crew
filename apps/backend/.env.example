# --- Digital Pet Passport: Apple Wallet (.pkpass) signing ---
# Pass Type ID + Team ID are public (printed in every pass); the .p12 and its
# password are secrets and must never be committed. base64-encode the .p12:
#   base64 -i pass.p12 | tr -d '\n'
APPLE_PASS_TYPE_ID=""
APPLE_TEAM_ID=""
APPLE_PASS_P12_BASE64=""
APPLE_PASS_P12_PASSWORD=""
# base64 of AppleWWDRCAG4.cer (public intermediate; completes the signing chain)
APPLE_WWDR_BASE64=""
# Base URL the pass QR points at for public verification (falls back to PUBLIC_CARD_BASE_URL)
PUBLIC_PASSPORT_BASE_URL=""
