PORT="4000"
APP_NAME="Yosemite"
NODE_ENV="development"

# --- Auth (provider-neutral boundary, #1672) -------------------------------
# Provider selection; supertokens is the only implemented provider.
AUTH_PROVIDER="supertokens"
# SuperTokens core (managed cloud or self-hosted)
SUPERTOKENS_CONNECTION_URI=""
SUPERTOKENS_API_KEY=""
# Public origins used for cookies/CORS and emails
AUTH_API_DOMAIN=""
AUTH_WEBSITE_DOMAIN=""
# Optional overrides (default /auth)
# AUTH_API_BASE_PATH="/auth"
# Kill-switch: set to "true" to disable the auth provider entirely
# SUPERTOKENS_DISABLED="false"
# CI/e2e only - never in production
# AUTH_REQUIRE_MFA="false"
# Social login (mobile); omit to disable the third-party recipe
AUTH_GOOGLE_CLIENT_ID=""
AUTH_GOOGLE_CLIENT_SECRET=""
AUTH_APPLE_CLIENT_ID=""
AUTH_APPLE_KEY_ID=""
AUTH_APPLE_PRIVATE_KEY=""
AUTH_APPLE_TEAM_ID=""
AUTH_FACEBOOK_APP_ID=""
AUTH_FACEBOOK_APP_SECRET=""

# --- Cutover grace window (time-boxed; remove after decommission) ----------
# Accept residual legacy bearer tokens while clients converge.
AUTH_LEGACY_TOKEN_GRACE="false"
COGNITO_REGION=""
COGNITO_USER_POOL_ID=""
COGNITO_USER_POOL_ID_MOBILE=""
COGNITO_AUDIENCE=""
FIREBASE_PROJECT_ID=""

# --- SMTP (auth + transactional emails) ------------------------------------
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="Yosemite Crew"

AWS_REGION=""
AWS_MAIL_DRIVER=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
ENCRYPTION_KEY=""
AWS_S3_BUCKET_NAME=""
JWT_SECRET=""
MONGODB_URI=""
MAIL_DRIVER=""
MERCK_HEALTHLINK_USERNAME=""
MERCK_HEALTHLINK_PASSWORD=""
MERCK_HEALTHLINK_BASE_URL=""
MERCK_HEALTHLINK_BASE_URL_US_CA=""
MERCK_HEALTHLINK_BASE_URL_GLOBAL=""
MERCK_HEALTHLINK_TIMEOUT_MS="10000"
