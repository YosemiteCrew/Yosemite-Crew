PORT="4000"
APP_NAME="Yosemite"
NODE_ENV="development"

# --- Auth (provider-neutral boundary, #1672) -------------------------------
# Provider selection; supertokens is the only implemented provider.
AUTH_PROVIDER="supertokens"
# SuperTokens core (managed cloud or self-hosted)
SUPERTOKENS_CONNECTION_URI=""
SUPERTOKENS_API_KEY=""
# Public origins used for cookies/CORS and emails
AUTH_API_DOMAIN=""
AUTH_WEBSITE_DOMAIN=""
# Optional overrides (default /auth)
# AUTH_API_BASE_PATH="/auth"
# Kill-switch: set to "true" to disable the auth provider entirely
# SUPERTOKENS_DISABLED="false"
# CI/e2e only - never in production
# AUTH_REQUIRE_MFA="false"
# Social login (mobile); omit to disable the third-party recipe
AUTH_GOOGLE_CLIENT_ID=""
AUTH_GOOGLE_CLIENT_SECRET=""
AUTH_APPLE_CLIENT_ID=""
# Apple Service ID used by the Android web flow; the id_token it mints is
# scoped to this instead of the iOS bundle identifier
AUTH_APPLE_SERVICE_ID=""
AUTH_APPLE_KEY_ID=""
AUTH_APPLE_PRIVATE_KEY=""
AUTH_APPLE_TEAM_ID=""
AUTH_FACEBOOK_APP_ID=""
AUTH_FACEBOOK_APP_SECRET=""

# --- Cutover grace window (time-boxed; remove after decommission) ----------
# Accept residual legacy bearer tokens while clients converge.
AUTH_LEGACY_TOKEN_GRACE="false"
COGNITO_REGION=""
COGNITO_USER_POOL_ID=""
COGNITO_USER_POOL_ID_MOBILE=""
COGNITO_AUDIENCE=""
FIREBASE_PROJECT_ID=""

# --- SMTP (auth + transactional emails) ------------------------------------
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="Yosemite Crew"

AWS_REGION=""
AWS_MAIL_DRIVER=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
ENCRYPTION_KEY=""
AWS_S3_BUCKET_NAME=""

# --- Outbound document fetching --------------------------------------------
# Stored document links (rendered-document PDFs, signing-provider downloads) are
# only fetched from hosts that resolve to a public address. Deployments that
# serve documents from an internal endpoint - a self-hosted object store on a
# private address, for example - opt those hosts in here as a comma-separated
# hostname list (no scheme, no port), e.g. "storage.internal,minio.svc.cluster.local".
# Leave empty unless you run such an endpoint: empty is the safe default.
DOCUMENT_FETCH_ALLOWED_INTERNAL_HOSTS=""

JWT_SECRET=""
MAIL_DRIVER=""
MERCK_HEALTHLINK_USERNAME=""
MERCK_HEALTHLINK_PASSWORD=""
MERCK_HEALTHLINK_BASE_URL=""
MERCK_HEALTHLINK_BASE_URL_US_CA=""
MERCK_HEALTHLINK_BASE_URL_GLOBAL=""
MERCK_HEALTHLINK_TIMEOUT_MS="10000"

# --- Companion card sharing ---
# Public origin of the web app that serves /card/<token>. Required to issue a
# share: the QR payload is scanned off-device, so it must be an absolute
# http(s) URL (e.g. https://your-app.example.com). A trailing slash is ignored.
PUBLIC_CARD_BASE_URL=""

# --- Digital Pet Passport: Apple Wallet (.pkpass) signing ---
# Pass Type ID + Team ID are public (printed in every pass); the .p12 and its
# password are secrets and must never be committed. base64-encode the .p12:
#   base64 -i pass.p12 | tr -d '\n'
APPLE_PASS_TYPE_ID=""
APPLE_TEAM_ID=""
APPLE_PASS_P12_BASE64=""
APPLE_PASS_P12_PASSWORD=""
# base64 of AppleWWDRCAG4.cer (public intermediate; completes the signing chain)
APPLE_WWDR_BASE64=""
# Base URL the pass QR points at for public verification (falls back to PUBLIC_CARD_BASE_URL)
PUBLIC_PASSPORT_BASE_URL=""

# --- Public booking page ---
# Public origin that serves /book/<slug>. Deliberately left blank: while it is
# blank the API returns a null public URL for every practice, and the onboarding
# wizard says the booking page is not live instead of showing an address that
# does not resolve. Set it only in an environment where the public route is
# actually deployed (e.g. https://dev.yosemitecrew.com). `book.yosemitecrew.com`
# has no DNS record - do not put it here until it does.
PUBLIC_BOOKING_BASE_URL=""

# --- Digital Pet Passport: Google Wallet ("Add to Google Wallet" save JWT) ---
# Issuer ID + service-account email are non-secret; the private key is secret.
# From the downloaded service-account JSON key, use client_email + private_key.
GOOGLE_WALLET_ISSUER_ID=""
GOOGLE_WALLET_SA_EMAIL=""
# Paste the JSON key's private_key value (keep the literal \n escapes)
GOOGLE_WALLET_SA_PRIVATE_KEY=""

# Optional brand imagery for wallet passes (public HTTPS URLs). Google fetches
# these directly; the Apple pass fetches the logo at build time and bundles it.
# Logo: square >=660x660 PNG. Hero: wide banner (~1032x336) for a passport-cover look.
PUBLIC_WALLET_LOGO_URL="https://raw.githubusercontent.com/YosemiteCrew/Yosemite-Crew/main/apps/mobileAppYC/src/assets/images/yosemite-logo-1024.png"
PUBLIC_WALLET_HERO_URL=""

# --- SuperAdmin panel contact mirror ---------------------------------------
# Best-effort forward of public contact-us submissions into the SuperAdmin
# panel's CRM intake (its /api/contact route). Leave both empty to disable
# mirroring; the submission is always stored in our own database regardless.
# Both /contact-us and /accessibility/report post to the same endpoint, so this
# one setting mirrors both forms.
# URL is the full intake endpoint, e.g. "https://<superadmin-host>/api/contact".
# The key must match CONTACT_INTAKE_KEY configured on the SuperAdmin side.
SUPERADMIN_CONTACT_INTAKE_URL=""
SUPERADMIN_CONTACT_INTAKE_KEY=""
# ActivityPub federation
AP_BASE_URL=""                  # Full public URL of this instance, e.g. https://api.yosemitecrew.com
AP_ENABLED="true"               # Set to "false" to disable AP endpoints
AP_AUTO_APPROVE_FOLLOWS="false" # Set to "true" to auto-accept incoming Follow requests
AP_LICENSE_AUTHORITY_URL=""     # Base URL for license JWK + revocation endpoints, served by SuperAdmin (default: https://admin.yosemitecrew.com)

# --- Developer portal billing (pay as you go) -------------------------------
# Stripe secret key for the account that owns the developer-portal products.
STRIPE_SECRET_KEY=""
# Price ID the Pro checkout subscribes the developer to. Must be a *metered*
# recurring price attached to a billing meter, otherwise checkout fails.
# The Pro plan advertises "First 1,000 calls free each month", and that allowance
# lives in this price, not in the app: configure it as a graduated tier price
# whose first tier is up_to=1000 at 0, with the per-call rate in the tier above.
# The backend reports every call, so a flat per-unit price here bills from call 1
# and contradicts the portal copy.
STRIPE_DEV_METERED_PRICE_ID=""
# event_name of that billing meter. Usage reporting is skipped entirely when this
# is unset, so a Pro developer would be served but never invoiced.
# The meter's aggregation must be `sum`: the backend posts one event per call.
STRIPE_DEV_METER_EVENT_NAME=""
# Signing secret of the webhook endpoint pointed at
# POST /v1/developers/billing/webhook. Without it a completed checkout never
# flips the org to the Pro plan, so a paying developer stays on the free quota.
# Subscribe the endpoint to: checkout.session.completed,
# customer.subscription.updated, customer.subscription.deleted.
STRIPE_DEV_WEBHOOK_SECRET=""

# --- Developer API keys -----------------------------------------------------
# Server-side pepper mixed into every stored developer API key digest.
# Required: issuing and verifying keys both fail with a 500 while it is unset.
# The digest must stay deterministic (verification is an indexed exact-match
# lookup), so a per-record salt is not an option - this pepper is what keeps a
# stolen DeveloperApiKeys dump from being brute-forced offline. Generate with
# `openssl rand -base64 48` and store it as a secret, never in the database.
# Rotating it invalidates every issued key, so treat it as permanent per env.
DEVELOPER_API_KEY_PEPPER=""
