{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2022",
    "outDir": "dist",
    "strict": true, // All strict type-checking options
    "esModuleInterop": true, // For importing CommonJS modules like Express
    "forceConsistentCasingInFileNames": true, // Catch inconsistent imports
    "moduleResolution": "node", // Resolve modules like Node.js
    "skipLibCheck": true, // Skip type checks on `node_modules`
    "resolveJsonModule": true, // Allow importing JSON files
    "types": ["node", "express", "jest"], // Include type definitions
    "noImplicitAny": true, // Prevent untyped variables
    "noUnusedLocals": false, // Warn on unused variables
    "noUnusedParameters": false,
    "baseUrl": ".",
    "paths": {
      "@yosemite-crew/lib": ["../../packages/lib/src/index.ts"],
      "@yosemite-crew/types": ["../../packages/types/src"],
      "@yosemite-crew/fhir": ["../../packages/fhir/src"],
      "@yosemite-crew/fhir-types": ["../../packages/fhir/src"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "integration/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
