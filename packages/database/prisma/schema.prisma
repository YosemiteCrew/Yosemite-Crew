// Prisma schema for tenant-scoped operational data.
// Run these migrations against a schema-scoped DATABASE_URL such as
// postgresql://.../db?schema=tenant_acme_clinic for each tenant schema.
// Shared control-plane tables are provisioned separately in public.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

