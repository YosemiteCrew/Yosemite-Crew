// ---------------------------------------------------------------------------
// Blood Bank
// ---------------------------------------------------------------------------

enum DonationStatus {
  COLLECTED
  PROCESSED
  AVAILABLE
  TRANSFUSED
  EXPIRED
  DISCARDED
}

model BloodBankDonor {
  id                     String    @id @default(uuid())
  organisationId         String
  patientId              String    @unique
  bloodType              BloodType
  lastScreeningAt        DateTime?
  lastDonationAt         DateTime?
  nextEligibleAt         DateTime?
  isActive               Boolean   @default(true)
  totalDonations         Int       @default(0)
  disqualificationReason String?
  notes                  String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  donations BloodDonationCollection[]

  @@index([organisationId, bloodType])
  @@index([organisationId, isActive])
  @@map("BloodBankDonor")
}

model BloodDonationCollection {
  id                String         @id @default(uuid())
  donorId           String
  organisationId    String
  collectedAt       DateTime
  collectedBy       String?
  volumeMl          Float
  anticoagulant     String?
