  modality               LabOrderModality @default(REFERENCE_LAB)
  idexxOrderId           String?
  uiUrl                  String?
  pdfUrl                 String?
  tests                  Json?
  veterinarian           String?
  technician             String?
  notes                  String?
  specimenCollectionDate String?
  ivls                   Json?
  requestPayload         Json?
  responsePayload        Json?
  error                  String?
  externalStatus         String?
  invoiceId              String?
  billedAt               DateTime?
  billingError           String?
