  updatedAt         DateTime       @updatedAt

  donor BloodBankDonor @relation(fields: [donorId], references: [id])

  @@index([organisationId, status])
  @@index([donorId])
  @@map("BloodDonationCollection")
}

// ---------------------------------------------------------------------------
